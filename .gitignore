# SentinelML V2 — .gitignore
# ===========================
# Prevents sensitive credentials and build artifacts from being committed.

# ── LOCAL CREDENTIALS — NEVER COMMIT ─────────────────────────────────────────
.env
.env.*
*.env
.sentinelml_v2.json
sentinelml-ai-backend/.env
sentinelml-ai-backend/.env.*

# ── PYINSTALLER BUILD ARTIFACTS ───────────────────────────────────────────────
build/
dist/
*.spec.bak
__pycache__/
*.pyc
*.pyo

# ── VIRTUALENVS ───────────────────────────────────────────────────────────────
venv/
linux_venv/
build_env/
.venv/
env/

# ── LOGS ──────────────────────────────────────────────────────────────────────
logs/
*.log
linux_build.log
linux_stage6.log
build_log.txt
build_log2.txt

# ── RUNTIME STATE (per-installation, never committed) ─────────────────────────
scan_audit_history.json
scan_audit_history.json.corrupt-*
scan_audit_history.json.tmp-*

# ── CRASH / TEMP FILES ────────────────────────────────────────────────────────
CRASH.log
*.tmp
*.bak

# ── PYTHON CACHE ──────────────────────────────────────────────────────────────
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── LOCAL WORKSPACE ARTIFACTS — NOT SOURCE ────────────────────────────────────
scratch/
backups/
review2_evidence/
extracted_ppt/
*.pptx
*.AppImage
Installer/
sentinelml-ai-backend/
.sentinelml_instance.lock
_dashboard_HEAD_backup.py
_recovery_block_A.py
gui/pages/*.bak*
gui/pages/dashboard_backup_*
models/v2/
alerts/alerts.json
data/dataset_audit_log.jsonl

# ── GENERATED REPORT OUTPUT (runtime evidence, not source) ────────────────────
reports/SentinelML_Incident_Report_*
reports/exhibition_demo_*
reports/file_integrity_*

# ── PLATFORM BUILD OUTPUTS ────────────────────────────────────────────────────
dist_linux*/
build_linux*/

# ── RELEASE EVIDENCE — intentionally tracked despite the log rules above ──────
!docs/releases/v3.1.0/logs/
!docs/releases/v3.1.0/logs/*.log
!docs/releases/v3.1.0/logs/*.txt
